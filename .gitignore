# renders and intermediates are rebuilt by the tools
**/frames/
**/renders/
**/review/*-vs-ref.*
node_modules/
__pycache__/
# built files (tools/build.mjs makes them from src/ + kit/ + the style)
plugins/**/index.html
plugins/**/review/

# reference media stays local (other people's work)
references/
**/index.html
pieces/*/voice/*.wav
pieces/*/voice/whisper.json
